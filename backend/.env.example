# Copy to .env and fill in what you use. .env is git-ignored.

# Depot (Parqet Connect): https://developer.parqet.com/console
PARQET_CLIENT_ID=
PARQET_CLIENT_SECRET=

# Bank (Enable Banking)
EB_APP_ID=
EB_PRIVATE_KEY_PATH=

# Plus payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_WEBHOOK_SECRET=

# Plus in the apps (App Store / Google Play), see README
APPLE_BUNDLE_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
GOOGLE_PACKAGE_NAME=
GOOGLE_SERVICE_ACCOUNT_PATH=

# AI (Buddy) — cheapest launch: set only GEMINI_API_KEY (leave Anthropic empty).
# Anthropic Haiku wins when both are set (~0.1¢/call); use it once Plus volume grows.
ANTHROPIC_API_KEY=
# free alternative while no Anthropic key is set: a key from aistudio.google.com
# (free tier with daily limits; outside the EU Google may use free-tier
# prompts to improve its products). GEMINI_MODEL defaults to gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

# WhatsApp Cloud API (optional). Empty = routes stay up, nothing is sent.
# Webhook: https://<PUBLIC_URL>/notify/whatsapp/webhook
# Numbers are stored as an HMAC only; send requires the in-app opt-in.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Hosting: leave empty for localhost; set BIND=0.0.0.0 behind Caddy/nginx.
# PORT=8090
# PUBLIC_URL=https://api.example.com
# BIND=0.0.0.0
# TRUST_PROXY=1
# CORS_ORIGINS=https://app.example.com,http://localhost:8765
# ALLOW_DEMO_BILLING=1   # only if you intentionally want free demo Plus on a public host
